{
  "name": "path-tracer-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.node.json",
    "typecheck": "tsc -p tsconfig.web.json && tsc -p tsconfig.node.json",
    "cli": "node dist-node/src/node/cli.js",
    "test": "tsc -p tsconfig.node.json && node --test \"dist-node/tests/core/*.test.js\"",
    "probe": "tsc -p tsconfig.node.json && node dist-node/scripts/probe.js",
    "verify-resume": "tsc -p tsconfig.node.json && node dist-node/scripts/verify_resume.js",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright": "^1.55.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "webm-muxer": "^5.0.3"
  }
}
